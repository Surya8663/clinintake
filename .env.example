# ------------------------------------------------------------------------------
# ClinIntake Environment Configuration Template
# ------------------------------------------------------------------------------
# IMPORTANT: All secrets MUST remain blank in this example file.
# Copy this file to `.env` and fill in the values for local development.
# ------------------------------------------------------------------------------

# -----------------------------------
# Lyzr Credentials & Governance Settings
# -----------------------------------
LYZR_API_KEY=
LYZR_BASE_URL=
LYZR_SUPERFLOW_ID=
LYZR_EXTRACTION_AGENT_ID=
LYZR_EXPLANATION_AGENT_ID=
LYZR_REFERRAL_AGENT_ID=
LYZR_WEBHOOK_SECRET=
LYZR_REQUEST_TIMEOUT=
LYZR_MAX_RETRIES=

# -----------------------------------
# Qdrant Configuration
# -----------------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=

# -----------------------------------
# LLM Provider Credentials
# -----------------------------------
LLM_API_KEY=
OPENAI_API_KEY=

# -----------------------------------
# Cryptography & Signing
# -----------------------------------
JWT_SECRET_KEY=
KEYCLOAK_CLIENT_SECRET=
IAM_JWT_SECRET=
AUDIT_HMAC_SECRET=
DOCUMENT_ENCRYPTION_KEY=

# -----------------------------------
# Databases
# -----------------------------------
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# -----------------------------------
# Message Brokers & Caches
# -----------------------------------
KAFKA_BROKER_URL=
REDPANDA_URL=
REDIS_URL=

# -----------------------------------
# External Integrations
# -----------------------------------
HAPI_FHIR_URL=
HAPI_FHIR_BASE_URL=
CLAMAV_HOST=
CLAMAV_PORT=
KEYCLOAK_URL=

# -----------------------------------
# Internal Service URLs
# -----------------------------------
ORCHESTRATOR_URL=
DOCUMENT_GATEWAY_URL=
DOCUMENT_SECURITY_FILTER_URL=
OCR_SERVICE_URL=
EXTRACTION_AGENT_URL=
PATIENT_IDENTITY_SERVICE_URL=
SCHEMA_VALIDATOR_URL=
TERMINOLOGY_SERVICE_URL=
CLINICAL_RULES_ENGINE_URL=
TEMPORAL_REASONING_ENGINE_URL=
DRUG_INTERACTION_SERVICE_URL=
GUIDELINE_RETRIEVAL_SERVICE_URL=
SAFETY_SUB_AGENT_URL=
CARE_GAP_EXPLANATION_AGENT_URL=
REFERRAL_DRAFTING_AGENT_URL=
CLINICAL_WORKSPACE_URL=
FHIR_INTEGRATION_SERVICE_URL=
FAILURE_QUEUE_SERVICE_URL=
NOTIFICATION_SYSTEM_URL=
IAM_SERVICE_URL=
COMPLIANCE_DASHBOARD_URL=
METRICS_DASHBOARD_URL=
GUARDRAIL_SERVICE_URL=
AUDIT_SERVICE_URL=

# -----------------------------------
# Observability & Metrics
