    "recommendation_strength": "Grade A",
    "population_tags": ["adults", "colorectal_cancer", "colonoscopy", "fit_test"],
    "source_url": "https://www.uspreventiveservicestaskforce.org/uspstf/recommendation/colorectal-cancer-screening",
    "document_checksum": "sha256:e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2",
    "clause_id": "USPSTF-CRC-A",
    "text": "The USPSTF recommends screening for colorectal cancer in all adults aged 45 to 75 years. Screening strategies include colonoscopy every 10 years, annual FIT, or stool DNA-FIT every 1 to 3 years."
